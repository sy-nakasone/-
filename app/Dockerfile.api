FROM python:3.11-slim

WORKDIR /app

# 依存関係をインストール（同じフォルダにある requirements.txt をコピー）
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 全ファイル（api.pyなど）をコピー
COPY . .

# ポート設定（Cloud Runが自動設定するが、デフォルト値を設定）
ENV PORT=8080
EXPOSE 8080

# gunicornで直接起動（シェル形式で環境変数を確実に展開）
CMD gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 8 --timeout 600 --access-logfile - --error-logfile - api:app