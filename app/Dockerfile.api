FROM python:3.11-slim

WORKDIR /app

# 依存関係をインストール（同じフォルダにある requirements.txt をコピー）
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 全ファイル（api.pyなど）をコピー
COPY . .

# 起動スクリプトに実行権限を付与
RUN chmod +x start_api.sh

# ポート設定（Cloud Runが自動設定するが、デフォルト値を設定）
ENV PORT=8080
EXPOSE 8080

# 起動スクリプトを実行
CMD ["./start_api.sh"]