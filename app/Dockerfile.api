FROM python:3.11-slim

WORKDIR /app

# 依存関係をインストール（同じフォルダにある requirements.txt をコピー）
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 全ファイル（api.pyなど）をコピー
COPY . .

# ポート設定
ENV PORT=8080
EXPOSE 8080

# gunicornで「工場（API）」を起動
CMD exec gunicorn --bind :$PORT --workers 1 --threads 8 --timeout 600 api:app